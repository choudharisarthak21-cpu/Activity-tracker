# Server Port (Default: 5000)
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas cloud URI)
# Example Local: mongodb://127.0.0.1:27017/activity_tracker
# Example Cloud: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/activity_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/activity_tracker

# JWT Authentication Secret Key (Minimum 32 random characters in production)
JWT_SECRET=your_jwt_secret_key_min_32_characters_here

# JWT Token Expiration Window (e.g. 7d, 30d)
JWT_EXPIRE=30d

# Node Environment ('development' or 'production')
NODE_ENV=development

# Allowed Client Frontend URL for CORS
CLIENT_URL=http://localhost:5173
